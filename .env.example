# Copy this file to .env and fill in your values
# Never commit .env to version control

# Deriv API credentials
# Create an API token at: https://app.deriv.com/account/api-token
DERIV_API_TOKEN=your_deriv_api_token_here

# Your Deriv App ID (default 1089 works for testing; create your own at https://api.deriv.com/)
DERIV_APP_ID=1089
